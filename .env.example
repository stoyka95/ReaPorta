# Zkopíruj do .env a uprav. Soubor .env se necommituje.

# Lokální PostgreSQL. Název databáze musí obsahovat "dev" nebo "test" (pojistka proti smazání).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reaporta_dev

# Veřejná adresa aplikace
APP_URL=http://localhost:3000

# Better Auth (vygeneruj: openssl rand -base64 32)
BETTER_AUTH_SECRET=change-me-to-a-long-random-string

# Mapa: bezklíčový styl (ověř, že odpovídá; jinak zapiš změnu do docs/DECISIONS.md)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# E-maily v dev: Mailpit (docker compose up -d) nebo jen tabulka email_outbox
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM="ReaPorta <noreply@reaporta.test>"

# Úložiště nahraných souborů
STORAGE_DIR=./storage

# Ochrana cron endpointu
CRON_SECRET=change-me-too

# Geokódování adres: none | nominatim | mapycz (mapycz vyžaduje MAPYCZ_API_KEY)
GEOCODER=none
MAPYCZ_API_KEY=
